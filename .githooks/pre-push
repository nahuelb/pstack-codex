#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [[ "${PSTACK_LOCAL_PLUGIN_PUSH:-}" != "1" ]]; then
  echo "Direct git push is disabled for this repository." >&2
  echo "Use ./scripts/push-and-reinstall-local-plugin.sh so the local Codex plugin is refreshed after a successful push." >&2
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Refusing to push with uncommitted changes." >&2
  exit 1
fi

zero_sha="0000000000000000000000000000000000000000"
head_commit="$(git rev-parse HEAD)"
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" == "$zero_sha" ]]; then
    continue
  fi
  pushed_commit="$(git rev-parse "${local_sha}^{commit}")"
  if [[ "$pushed_commit" != "$head_commit" ]]; then
    echo "Refusing to push $local_ref because it does not point at the checked-out HEAD." >&2
    echo "Check out the ref and use the wrapper again so verification covers the pushed content." >&2
    exit 1
  fi
  plugin_version="$(git show "${pushed_commit}:.codex-plugin/plugin.json" | node -e 'let input=""; process.stdin.on("data", chunk => input += chunk); process.stdin.on("end", () => process.stdout.write(JSON.parse(input).version ?? ""));')"
  if [[ "$plugin_version" != *"+codex."* ]]; then
    echo "The pushed plugin version is missing its Codex cachebuster suffix." >&2
    echo "Run the cachebuster command documented in AGENTS.md before the final commit." >&2
    exit 1
  fi
  if git rev-parse --verify "${pushed_commit}^" >/dev/null 2>&1 && git diff --quiet "${pushed_commit}^" "$pushed_commit" -- .codex-plugin/plugin.json; then
    echo "The pushed tip does not include a .codex-plugin/plugin.json cachebuster change." >&2
    echo "Run the cachebuster command documented in AGENTS.md, commit the result, and push again." >&2
    exit 1
  fi
done

while IFS= read -r variable; do
  unset "$variable"
done < <(git rev-parse --local-env-vars)

npm run verify:offline
